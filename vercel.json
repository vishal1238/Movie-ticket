{
  "version": 2,
  "buildCommand": "cd cinema-book/client && npm install && npm run build",
  "outputDirectory": "cinema-book/client/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/cinema-book/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
